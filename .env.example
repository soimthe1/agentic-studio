# Agent Studio (agent-studio) - development secrets. Copy to .env and fill in. Never commit .env.
# Everything that is not a secret lives in config/config.yaml.

# Local break-glass administrator (Langflow superuser); users sign in with Active Directory.
LANGFLOW_SUPERUSER=studio-admin
LANGFLOW_SUPERUSER_PASSWORD=<long random password>
# Signs sessions and encrypts stored credentials. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
LANGFLOW_SECRET_KEY=<random 32+ characters>
# Password of the "agent_studio" login on the existing PostgreSQL server (config.yaml database:).
STUDIO_DB_PASSWORD=<password>
# Shared secret between the Agent Studio app and the engine (engine session endpoint). 32+ characters.
STUDIO_ENGINE_SECRET=<random 48 characters>
# Read-only account for IIS Monitor (studio-tools, config/tools.yaml apps.iis).
STUDIO_TOOL_IIS_PASSWORD=<password>
